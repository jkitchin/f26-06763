# Figure generation cache (raw data, not committed)
lectures/*/figures/.cache/
lectures/*/.cache/

# claude
.claude/

# Build output
_build/
.jupyter_cache/
*.html
!themes/*.html
# The game's entry point is *source*, not rendered output. The blanket *.html
# rule above silently excluded it, and the app built fine locally while CI got
# "Could not resolve entry module index.html".
!game/index.html
# Same trap for the clicker: worker.js does `import VOTE_PAGE from './vote.html'`,
# so this file is source. Without it, `wrangler deploy` fails on a fresh clone.
!clicker/vote.html
# And once more for the arcade's development harness, which is the page you open
# to play a game against a local Worker. Source, not build output.
!arcade/local.html

# Node (marp via npx)
node_modules/

# Python
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# MLflow tracking output, written by the demo notebooks when they are run
mlruns/
mlflow.db

# Data: keep raw data out of git, track schemas and small samples deliberately
data/
*.parquet
*.duckdb

# MLflow local store (created by the L2 demo when run in place)
mlflow.db
mlruns/
mlartifacts/

# macOS / Emacs
.DS_Store
*~
\#*\#
.#*

# pytest, from the quiz tests
.pytest_cache/

# PyTorch checkpoints written by demo notebooks
*.pt
*.pth

# A lecture deck with a clicker slide references figures/clicker-qr.png and
# clicker-slide.js as relative paths, which CI copies in beside each rendered
# deck (book.yml, "Render MARP slide decks"). Rendering one locally needs the
# same two files beside the deck, so symlink them and let git ignore the
# symlinks: the QR lives once in clicker/figures/, and 22 committed copies of it
# would drift the day the vote URL changes.
lectures/*/figures/clicker-qr.png
lectures/*/clicker-slide.js
